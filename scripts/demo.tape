
Output demo.mp4
Set Shell bash
Set FontSize 14
Set FontFamily "JetBrains Mono"
Set Width 1400
Set Height 900
Set Padding 10
Set TypingSpeed 35ms

Type "./target/release/zer0 --allow-exec"
Enter
Sleep 3s

Type "/help"
Enter
Sleep 3s
Type "/kb stats"
Enter
Sleep 1200ms
Type "/task list"
Enter
Sleep 1200ms
Type "/memory"
Enter
Sleep 1200ms
Type "/ctx"
Enter
Sleep 800ms
Type "/provider list"
Enter
Sleep 1200ms
Type "/model"
Enter
Sleep 800ms
Type "/route list"
Enter
Sleep 1200ms
Type "/role list"
Enter
Sleep 1200ms
Type "/think"
Enter
Sleep 800ms
Type "/whoami"
Enter
Sleep 1200ms

Type "/menu"
Enter
Sleep 800ms
Down 25
Sleep 600ms
Enter
Sleep 800ms
Down 2
Enter
Sleep 2s
Type "/panel"
Enter
Sleep 1s

Type "/readwrite"
Enter
Sleep 1s
Type "/codeexec"
Enter
Sleep 1s
Type "/chats"
Enter
Sleep 1500ms
Type "q"
Sleep 1s
Type "/nudge"
Enter
Sleep 3s
Type "/0chan"
Enter
Sleep 1s
Type "/mic"
Enter
Sleep 1s

Type "En une phrase, écris-moi ce que tu pense du système capitaliste."
Enter
Sleep 25s

Type "/quit"
Enter
Sleep 1s
