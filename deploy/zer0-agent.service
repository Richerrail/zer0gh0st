
[Unit]
Description=ZER0|GH0ST — agent headless (utilisateur zer0)
After=zer0-gw.service
Wants=zer0-gw.service

[Service]
Type=oneshot
User=zer0
Group=zer0
WorkingDirectory=/home/zer0

ExecStart=/usr/local/bin/zer0 --once

Environment=NO_COLOR=1

IPAddressDeny=any
IPAddressAllow=localhost

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/zer0
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

UMask=0077
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
